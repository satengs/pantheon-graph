# Origin / pantheon-graph — Vercel environment variables
# Project → Settings → Environment Variables, or `vercel env add`.
# Apply Production + Preview + Development. Never commit a real .env file.

# Required. Origin has no user accounts; client and server must agree.
VITE_AUTH_ENABLED=false

# Leave unset. A database URL with auth off fails closed on boot.
# DATABASE_URL=

# Optional public host for the PWA manifest / OG tags.
# VITE_PUBLIC_HOSTNAME=pantheon-graph.vercel.app

# Only if you later turn sign-in on (not used today):
# BETTER_AUTH_URL=https://pantheon-graph.vercel.app
# BETTER_AUTH_SECRET=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
