# Origin / pantheon-graph — Vercel environment variables
# Project → Settings → Environment Variables. Never commit a real .env file.

# Auth is on. Omit or set true. Client and server must agree.
VITE_AUTH_ENABLED=true

# Provisioned automatically when deploy.database is true / migrations ship.
# DATABASE_URL=

# Optional public host for the PWA manifest / OG tags.
# VITE_PUBLIC_HOSTNAME=pantheon-graph.vercel.app

# BETTER_AUTH_URL=https://pantheon-graph.vercel.app
# BETTER_AUTH_SECRET=
# GROK_AUTH_ISSUER=
# GROK_AUTH_CLIENT_ID=
# GROK_AUTH_CLIENT_SECRET=
